{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": false,
		"isolatedModules": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"jsx": "react",
		"types": ["node"],
		"lib": ["DOM", "ES2022"]
	},
	"include": ["src/**/*"]
}
